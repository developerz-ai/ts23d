# Copy to .env (gitignored; Bun loads it automatically) and fill in what you use.
# Every key is optional: the CPU tier builds with none of them.

# Meshy (meshy.ai) image/text → 3D mesh adapter: meshyAdapter({ apiKey: process.env.MESHY_API_KEY })
MESHY_API_KEY=
# Kubeez (kubeez.com, partner) image generation without a GPU: kubeezAdapter({ apiKey: process.env.KUBEEZ_API_KEY })
KUBEEZ_API_KEY=
# OpenAI image adapter: openaiImageAdapter({ apiKey: process.env.OPENAI_API_KEY })
OPENAI_API_KEY=
# Hugging Face token for gated model weights in `t3d setup gpu-*` (read at install, never stored)
HF_TOKEN=
# Where `t3d setup` puts the optional tier (venv, weights, GPU lease). Default ~/.ts23d
# TS23D_HOME=
