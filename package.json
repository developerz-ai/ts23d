{
  "name": "@developerz.ai/ts23d",
  "version": "0.5.0",
  "description": "TypeScript to 3D (ts23d): free, deterministic 3D asset generation in TypeScript — a DSL your coding agent writes, compiled to game-ready glTF.",
  "type": "module",
  "license": "MIT",
  "author": "developerz.ai",
  "homepage": "https://developerz-ai.github.io/ts23d/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/developerz-ai/ts23d.git"
  },
  "bugs": "https://github.com/developerz-ai/ts23d/issues",
  "keywords": [
    "3d",
    "procedural",
    "gltf",
    "glb",
    "dsl",
    "game-assets",
    "ai-agents",
    "claude-code",
    "codex",
    "three"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "bun": "./src/core/index.ts",
      "default": "./dist/core/index.js"
    },
    "./grammar": {
      "types": "./dist/grammar/index.d.ts",
      "bun": "./src/grammar/index.ts",
      "default": "./dist/grammar/index.js"
    },
    "./material": {
      "types": "./dist/material/index.d.ts",
      "bun": "./src/material/index.ts",
      "default": "./dist/material/index.js"
    },
    "./primitives": {
      "types": "./dist/primitives/index.d.ts",
      "bun": "./src/primitives/index.ts",
      "default": "./dist/primitives/index.js"
    },
    "./audio": {
      "types": "./dist/audio/index.d.ts",
      "bun": "./src/audio/index.ts",
      "default": "./dist/audio/index.js"
    },
    "./neural": {
      "types": "./dist/neural/index.d.ts",
      "bun": "./src/neural/index.ts",
      "default": "./dist/neural/index.js"
    },
    "./passes": {
      "types": "./dist/passes/index.d.ts",
      "bun": "./src/passes/index.ts",
      "default": "./dist/passes/index.js"
    },
    "./physics": {
      "types": "./dist/physics/index.d.ts",
      "bun": "./src/physics/index.ts",
      "default": "./dist/physics/index.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "bun": "./src/data/index.ts",
      "default": "./dist/data/index.js"
    },
    "./kinds": {
      "types": "./dist/kinds/index.d.ts",
      "bun": "./src/kinds/index.ts",
      "default": "./dist/kinds/index.js"
    },
    "./qa": {
      "types": "./dist/qa/index.d.ts",
      "bun": "./src/qa/index.ts",
      "default": "./dist/qa/index.js"
    },
    "./export": {
      "types": "./dist/export/index.d.ts",
      "bun": "./src/export/index.ts",
      "default": "./dist/export/index.js"
    },
    "./render": {
      "types": "./dist/render/index.d.ts",
      "bun": "./src/render/index.ts",
      "default": "./dist/render/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "bun": "./src/testing/index.ts",
      "default": "./dist/testing/index.js"
    },
    "./tune": {
      "types": "./dist/tune/index.d.ts",
      "bun": "./src/tune/index.ts",
      "default": "./dist/tune/index.js"
    },
    "./finish": {
      "types": "./dist/finish/index.d.ts",
      "bun": "./src/finish/index.ts",
      "default": "./dist/finish/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "t3d": "./dist/cli/bin.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "src",
    "!src/**/*.test.ts",
    "docs",
    "!docs/reference/*.png",
    "recipes",
    "!recipes/**/*.test.ts",
    "!recipes/**/*.png",
    "!recipes/*/out",
    "!docs/media",
    "examples",
    "README.md",
    "CLAUDE.md",
    "llms.txt",
    "CHANGELOG.md",
    "NOTICE",
    "LICENSE",
    ".claude/skills",
    ".claude/agents",
    ".claude/commands",
    "!examples/**/*.test.ts"
  ],
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "setup": "bun run scripts/setup.ts",
    "verify": "bun run scripts/verify.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test --timeout 120000 src scripts examples apps/site/src",
    "build": "bun run scripts/build.ts",
    "prepack": "bun run build",
    "boundaries": "bun run scripts/boundaries.ts",
    "determinism": "bun run scripts/determinism.ts",
    "filesize": "bun run scripts/filesize.ts",
    "placeholders": "bun run scripts/placeholders.ts",
    "recipes": "bun run scripts/recipes.ts",
    "shots": "bun run scripts/shots.ts",
    "parts": "bun run scripts/parts-catalogue.ts",
    "data": "bun run scripts/data.ts",
    "textures": "bun run scripts/textures.ts",
    "release": "bun run scripts/release.ts",
    "changelog": "bun run scripts/changelog.ts",
    "t3d": "bun run src/cli/bin.ts",
    "site:dev": "bun run --filter @ts23d/site dev",
    "site:build": "bun run --filter @ts23d/site build",
    "site:shots": "bun run scripts/site-shots.ts",
    "bench": "bun run scripts/bench.ts"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/bun": "1.4.4",
    "gltf-validator": "2.0.0-dev.3.10",
    "lefthook": "2.2.2",
    "typescript": "7.0.2"
  },
  "trustedDependencies": [],
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=22"
  }
}
